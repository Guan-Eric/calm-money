rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function inHousehold(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && uid() in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      // Create own profile — never bootstrap Pro yourself
      allow create: if signedIn()
        && uid() == userId
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false);
      // Own profile updates — Pro flag + householdId are Functions-only
      allow update: if signedIn()
        && uid() == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isPremium', 'premiumSyncedAt', 'householdId']);
      allow delete: if false;
    }

    match /households/{householdId} {
      allow read: if signedIn() && (
        uid() in resource.data.memberIds
        || userDoc().householdId == householdId
      );
      // Solo household bootstrap only
      allow create: if signedIn()
        && request.resource.data.memberIds.size() == 1
        && uid() in request.resource.data.memberIds
        && request.resource.data.memberIds[0] == uid();
      // Members may edit region/currency only — membership & invites are Functions-only
      allow update: if signedIn() && uid() in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['countryCode', 'defaultCurrency']);
      // Orphan self-heal: profile points here but memberIds missing you — add only yourself
      allow update: if signedIn()
        && userDoc().householdId == householdId
        && !(uid() in resource.data.memberIds)
        && uid() in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
      allow delete: if false;
    }

    match /sharingPrefs/{prefId} {
      allow read: if signedIn() && (
        resource.data.userId == uid()
        || inHousehold(resource.data.householdId)
      );
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && prefId == uid() + '_' + request.resource.data.householdId;
      allow update: if signedIn()
        && (
          resource.data.userId == uid()
          || prefId == uid() + '_' + resource.data.householdId
        )
        && request.resource.data.userId == uid()
        && request.resource.data.householdId == resource.data.householdId;
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if inHousehold(resource.data.householdId);
      allow create: if inHousehold(request.resource.data.householdId);
      allow update: if inHousehold(resource.data.householdId)
        && request.resource.data.householdId == resource.data.householdId;
      allow delete: if inHousehold(resource.data.householdId);
    }

    match /transactions/{txnId} {
      allow read: if inHousehold(resource.data.householdId)
        && (
          resource.data.createdBy == uid()
          || resource.data.visibility == 'household'
        );
      allow create: if inHousehold(request.resource.data.householdId)
        && request.resource.data.createdBy == uid()
        && request.resource.data.visibility in ['private', 'household'];
      allow update: if inHousehold(resource.data.householdId)
        && resource.data.createdBy == uid()
        && request.resource.data.createdBy == uid()
        && request.resource.data.householdId == resource.data.householdId;
      allow delete: if inHousehold(resource.data.householdId)
        && resource.data.createdBy == uid();
    }

    match /merchantRules/{ruleId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if signedIn() && resource.data.userId == uid();
    }

    // Invites: creator may read/revoke; create/accept are Cloud Functions only
    match /householdInvites/{inviteId} {
      allow read: if signedIn() && resource.data.createdBy == uid();
      allow create: if false;
      allow update: if signedIn()
        && resource.data.createdBy == uid()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.code == resource.data.code
        && request.resource.data.status in ['pending', 'revoked'];
      allow delete: if false;
    }

    match /bankConnections/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create, update: if signedIn()
        && id.matches('demo_.*')
        && request.resource.data.userId == uid();
      allow delete: if signedIn()
        && id.matches('demo_.*')
        && resource.data.userId == uid();
    }

    match /bankConnectionSecrets/{id} {
      allow read, write: if false;
    }

    match /bankAccounts/{id} {
      // Own accounts always; partner only when owner opted into sharing
      allow read: if signedIn() && (
        resource.data.ownerUserId == uid()
        || (
          inHousehold(resource.data.householdId)
          && exists(/databases/$(database)/documents/sharingPrefs/$(resource.data.ownerUserId + '_' + resource.data.householdId))
          && get(/databases/$(database)/documents/sharingPrefs/$(resource.data.ownerUserId + '_' + resource.data.householdId)).data.shareTransactions == true
        )
      );
      allow create, update: if signedIn()
        && id.matches('demo_.*')
        && request.resource.data.ownerUserId == uid()
        && inHousehold(request.resource.data.householdId);
      allow delete: if signedIn()
        && id.matches('demo_.*')
        && resource.data.ownerUserId == uid();
    }
  }
}
