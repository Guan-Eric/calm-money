rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function inHousehold(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && uid() in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /households/{householdId} {
      // Members can read; also allow read when the signed-in user's profile points here
      // so a broken membership can be detected and repaired by the client.
      allow read: if signedIn() && (
        (exists(/databases/$(database)/documents/households/$(householdId))
          && uid() in resource.data.memberIds)
        || get(/databases/$(database)/documents/users/$(uid())).data.householdId == householdId
      );
      allow create: if signedIn() && uid() in request.resource.data.memberIds;
      allow update: if signedIn() && (
        uid() in resource.data.memberIds
        || get(/databases/$(database)/documents/users/$(uid())).data.householdId == householdId
      );
    }

    match /sharingPrefs/{prefId} {
      allow read: if signedIn() && (
        resource.data.userId == uid()
        || inHousehold(resource.data.householdId)
      );
      // Prefer doc-id ownership so older prefs missing userId still work
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && prefId == uid() + '_' + request.resource.data.householdId;
      allow update: if signedIn()
        && (
          resource.data.userId == uid()
          || prefId == uid() + '_' + resource.data.householdId
        )
        && request.resource.data.userId == uid();
    }

    match /categories/{categoryId} {
      allow read: if inHousehold(resource.data.householdId)
        || get(/databases/$(database)/documents/users/$(uid())).data.householdId == resource.data.householdId;
      allow create, update: if signedIn()
        && (
          inHousehold(request.resource.data.householdId)
          || get(/databases/$(database)/documents/users/$(uid())).data.householdId == request.resource.data.householdId
        );
    }

    match /transactions/{txnId} {
      allow read: if inHousehold(resource.data.householdId)
        && (
          resource.data.createdBy == uid()
          || resource.data.visibility == 'household'
        );
      allow create: if inHousehold(request.resource.data.householdId)
        && request.resource.data.createdBy == uid();
      allow update, delete: if inHousehold(resource.data.householdId)
        && resource.data.createdBy == uid();
    }

    match /merchantRules/{ruleId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if signedIn() && resource.data.userId == uid();
    }

    // Invites: creator can read/update own; others use Cloud Functions for lookup by code
    match /householdInvites/{inviteId} {
      allow read: if signedIn() && resource.data.createdBy == uid();
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      allow update: if signedIn() && resource.data.createdBy == uid();
    }

    match /bankConnections/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
      // Demo seed docs only (id starts with demo_); real Plaid writes stay Functions-only
      allow create, update: if signedIn()
        && id.matches('demo_.*')
        && request.resource.data.userId == uid();
      allow delete: if signedIn()
        && id.matches('demo_.*')
        && resource.data.userId == uid();
    }

    match /bankConnectionSecrets/{id} {
      allow read, write: if false;
    }

    match /bankAccounts/{id} {
      allow read: if inHousehold(resource.data.householdId);
      allow create, update: if signedIn()
        && id.matches('demo_.*')
        && request.resource.data.ownerUserId == uid()
        && inHousehold(request.resource.data.householdId);
      allow delete: if signedIn()
        && id.matches('demo_.*')
        && resource.data.ownerUserId == uid();
    }
  }
}
