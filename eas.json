{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_MOCK_PREMIUM": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MOCK_PREMIUM": "false"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_MOCK_PREMIUM": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
