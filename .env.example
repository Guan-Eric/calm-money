# Firebase (client — safe to embed)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# RevenueCat public SDK keys (Test Store uses test_… for both platforms)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Local UI testing only — treats user as Pro without store
EXPO_PUBLIC_MOCK_PREMIUM=false


# Plaid + token encryption belong in Firebase Functions secrets (never in the app):
#   export PLAID_CLIENT_ID=... PLAID_SECRET=... PLAID_ENV=sandbox
#   export TOKEN_ENCRYPTION_KEY="$(openssl rand -base64 32)"
#   ./scripts/set-function-secrets.sh
# Apple Sign-In: configure in Apple Developer + Firebase Auth console
# EAS: npx eas init (writes extra.eas.projectId); then eas build --profile development
