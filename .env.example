# Firebase (client — safe to embed)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# RevenueCat public SDK keys
# Development / preview: Test Store (test_…)
# Production EAS: appl_ (iOS) / goog_ (Android) — see docs/eas-env-revenuecat.txt
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Local / development-client only — ignored in release binaries (__DEV__ gate)
# EAS development profile sets this true; preview + production force false
EXPO_PUBLIC_MOCK_PREMIUM=false

# --- Secrets that must NOT live in the app ---
# Firebase Functions (Plaid + token encryption):
#   export PLAID_CLIENT_ID=... PLAID_SECRET=... PLAID_ENV=sandbox   # or production
#   export TOKEN_ENCRYPTION_KEY="$(openssl rand -base64 32)"
#   ./scripts/set-function-secrets.sh
#
# EAS profiles (see eas.json + README “Builds”):
#   development — mock Pro on, Test Store OK, Plaid sandbox
#   preview     — mock Pro off, Test Store OK until live keys, Plaid sandbox
#   production  — mock Pro off, appl_/goog_ via EAS secrets, Plaid production
#
# Apple Sign-In: ./scripts/apple-signin-checklist.sh
# Ship checklist: ./scripts/production-checklist.sh
